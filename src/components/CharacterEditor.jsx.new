import { useState, useEffect } from 'react';
import { Tabs, Card, Input, Button, Slider, Select, Tag, message, Collapse, Divider } from 'antd';
import { PlusOutlined, DeleteOutlined, EditOutlined } from '@ant-design/icons';
import agentRegistry from '../agent_registry';
import trustMap from '../trust_map';
import ModelSelector from './ModelSelector';

export default function CharacterEditor({ agentId }) {
  const [agent, setAgent] = useState(null);
  const [relationships, setRelationships] = useState({});
  const [isEditing, setIsEditing] = useState(false);
  const [activeTab, setActiveTab] = useState('basic');
  
  const { TabPane } = Tabs;
  const { Panel } = Collapse;
  const { Option } = Select;
  
  // 加载角色数据
  useEffect(() => {
    if (agentId) {
      try {
        const agentData = agentRegistry.get(agentId);
        
        // 检查agentData是否存在
        if (!agentData) {
          console.error(`找不到ID为 ${agentId} 的角色数据`);
          // 创建一个空的角色数据对象
          setAgent({
            id: agentId,
            name: `角色 ${agentId}`,
            skills: [],
            relationships: [],
            personality: {
              openness: 50,
              conscientiousness: 50,
              extraversion: 50,
              agreeableness: 50,
              neuroticism: 50
            },
            llmConfig: {
              provider: 'openai',
              model: 'gpt-4o',
              apiKey: '',
              temperature: 0.7,
              maxTokens: 2000
            }
          });
          setRelationships({});
          return;
        }
        
        // 确保agent数据完整
        const defaultPersonality = {
          openness: 50,
          conscientiousness: 50,
          extraversion: 50,
          agreeableness: 50,
          neuroticism: 50
        };
        
        // 处理personality，确保它是一个对象而不是字符串
        let personality = defaultPersonality;
        if (agentData.personality) {
          if (typeof agentData.personality === 'object') {
            personality = {
              ...defaultPersonality,
              ...agentData.personality
            };
          } else if (typeof agentData.personality === 'string') {
            // 如果personality是字符串，则使用默认值
            console.warn(`角色 ${agentId} 的personality是字符串，已替换为默认对象`);
          }
        }
        
        // 确保agent有llmConfig属性
        const defaultLLMConfig = {
          provider: 'openai',
          model: 'gpt-4o',
          apiKey: '',
          temperature: 0.7,
          maxTokens: 2000
        };
        
        setAgent({ 
          ...agentData,
          skills: Array.isArray(agentData.skills) ? agentData.skills : [],
          relationships: Array.isArray(agentData.relationships) ? agentData.relationships : [],
          personality: personality,
          llmConfig: agentData.llmConfig || defaultLLMConfig
        });
        
        // 加载关系数据
        const rels = {};
        if (typeof agentRegistry.getAll === 'function') {
          agentRegistry.getAll().forEach(otherAgent => {
            if (otherAgent.id !== agentId) {
              rels[otherAgent.id] = trustMap.getTrustLevel(agentId, otherAgent.id);
            }
          });
        }
        setRelationships(rels);
      } catch (error) {
        console.error(`加载角色数据错误:`, error, `agentId: ${agentId}`);
        // 创建一个空的角色数据对象
        setAgent({
          id: agentId,
          name: `角色 ${agentId}`,
          skills: [],
          relationships: [],
          personality: {
            openness: 50,
            conscientiousness: 50,
            extraversion: 50,
            agreeableness: 50,
            neuroticism: 50
          },
          llmConfig: {
            provider: 'openai',
            model: 'gpt-4o',
            apiKey: '',
            temperature: 0.7,
            maxTokens: 2000
          }
        });
        setRelationships({});
      }
    }
  }, [agentId]);

  // 保存角色数据
  const saveAgent = () => {
    if (agent) {
      agentRegistry.register(agent);
      setIsEditing(false);
      message.success('角色数据已保存');
    }
  };
  
  // 更新LLM配置
  const handleLLMConfigChange = (newConfig) => {
    setAgent({
      ...agent,
      llmConfig: newConfig
    });
  };

  if (!agent) return <div className="p-4 text-gray-400">请选择角色</div>;

  return (
    <div className="character-editor">
      <Card 
        title={isEditing ? 
          <Input 
            value={agent.name} 
            onChange={(e) => setAgent({...agent, name: e.target.value})} 
            placeholder="角色名称"
          /> : 
          agent.name
        }
        extra={
          isEditing ? (
            <div>
              <Button type="primary" onClick={saveAgent} style={{marginRight: '8px'}}>保存</Button>
              <Button onClick={() => setIsEditing(false)}>取消</Button>
            </div>
          ) : (
            <Button type="primary" onClick={() => setIsEditing(true)} icon={<EditOutlined />}>编辑</Button>
          )
        }
      >
        <Tabs activeKey={activeTab} onChange={setActiveTab}>
          {/* 基本信息标签页 */}
          <TabPane tab="基本信息" key="basic">
            <div className="mb-4">
              <div className="mb-2 font-bold">描述</div>
              {isEditing ? (
                <Input.TextArea 
                  value={agent.description} 
                  onChange={(e) => setAgent({...agent, description: e.target.value})}
                  rows={4}
                  placeholder="角色描述"
                />
              ) : (
                <p>{agent.description || '无描述'}</p>
              )}
            </div>
            
            <div className="mb-4">
              <div className="mb-2 font-bold">类型</div>
              {isEditing ? (
                <Select
                  value={agent.type}
                  onChange={(value) => setAgent({...agent, type: value})}
                  style={{ width: '100%' }}
                >
                  <Option value="player">玩家角色</Option>
                  <Option value="gm">游戏主持人</Option>
                  <Option value="npc">NPC</Option>
                </Select>
              ) : (
                <p>
                  {agent.type === 'player' ? '玩家角色' : 
                   agent.type === 'gm' ? '游戏主持人' : 'NPC'}
                </p>
              )}
            </div>
          </TabPane>
          
          {/* 技能标签页 */}
          <TabPane tab="技能" key="skills">
            <div className="mb-4">
              {isEditing ? (
                <div>
                  {agent.skills.map((skill, index) => (
                    <div key={index} className="flex items-center mb-2">
                      <Input 
                        value={skill.name} 
                        onChange={(e) => {
                          const newSkills = [...agent.skills];
                          newSkills[index] = {...newSkills[index], name: e.target.value};
                          setAgent({...agent, skills: newSkills});
                        }}
                        placeholder="技能名称"
                        style={{ width: '40%', marginRight: '8px' }}
                      />
                      <Input 
                        value={skill.level} 
                        onChange={(e) => {
                          const newSkills = [...agent.skills];
                          newSkills[index] = {...newSkills[index], level: e.target.value};
                          setAgent({...agent, skills: newSkills});
                        }}
                        placeholder="技能等级"
                        style={{ width: '40%', marginRight: '8px' }}
                      />
                      <Button 
                        danger 
                        icon={<DeleteOutlined />} 
                        onClick={() => {
                          const newSkills = agent.skills.filter((_, i) => i !== index);
                          setAgent({...agent, skills: newSkills});
                        }}
                      />
                    </div>
                  ))}
                  <Button 
                    type="dashed" 
                    onClick={() => {
                      setAgent({
                        ...agent, 
                        skills: [...agent.skills, {name: '', level: ''}]
                      });
                    }}
                    icon={<PlusOutlined />}
                    style={{ width: '100%' }}
                  >
                    添加技能
                  </Button>
                </div>
              ) : (
                <div>
                  {agent.skills.length > 0 ? (
                    agent.skills.map((skill, index) => (
                      <Tag key={index} color="blue" style={{ marginBottom: '8px' }}>
                        {skill.name}: {skill.level}
                      </Tag>
                    ))
                  ) : (
                    <p>无技能</p>
                  )}
                </div>
              )}
            </div>
          </TabPane>
          
          {/* 性格标签页 */}
          <TabPane tab="性格" key="personality">
            <div className="mb-4">
              {isEditing ? (
                <div>
                  <div className="mb-2">
                    <div className="mb-1">开放性 (Openness)</div>
                    <Slider 
                      value={agent.personality.openness} 
                      onChange={(value) => setAgent({
                        ...agent, 
                        personality: {...agent.personality, openness: value}
                      })}
                      min={0}
                      max={100}
                    />
                  </div>
                  <div className="mb-2">
                    <div className="mb-1">尽责性 (Conscientiousness)</div>
                    <Slider 
                      value={agent.personality.conscientiousness} 
                      onChange={(value) => setAgent({
                        ...agent, 
                        personality: {...agent.personality, conscientiousness: value}
                      })}
                      min={0}
                      max={100}
                    />
                  </div>
                  <div className="mb-2">
                    <div className="mb-1">外向性 (Extraversion)</div>
                    <Slider 
                      value={agent.personality.extraversion} 
                      onChange={(value) => setAgent({
                        ...agent, 
                        personality: {...agent.personality, extraversion: value}
                      })}
                      min={0}
                      max={100}
                    />
                  </div>
                  <div className="mb-2">
                    <div className="mb-1">亲和性 (Agreeableness)</div>
                    <Slider 
                      value={agent.personality.agreeableness} 
                      onChange={(value) => setAgent({
                        ...agent, 
                        personality: {...agent.personality, agreeableness: value}
                      })}
                      min={0}
                      max={100}
                    />
                  </div>
                  <div className="mb-2">
                    <div className="mb-1">神经质 (Neuroticism)</div>
                    <Slider 
                      value={agent.personality.neuroticism} 
                      onChange={(value) => setAgent({
                        ...agent, 
                        personality: {...agent.personality, neuroticism: value}
                      })}
                      min={0}
                      max={100}
                    />
                  </div>
                </div>
              ) : (
                <div>
                  <p><strong>开放性:</strong> {agent.personality.openness}%</p>
                  <p><strong>尽责性:</strong> {agent.personality.conscientiousness}%</p>
                  <p><strong>外向性:</strong> {agent.personality.extraversion}%</p>
                  <p><strong>亲和性:</strong> {agent.personality.agreeableness}%</p>
                  <p><strong>神经质:</strong> {agent.personality.neuroticism}%</p>
                </div>
              )}
            </div>
          </TabPane>
          
          {/* 关系标签页 */}
          <TabPane tab="关系" key="relationships">
            <div className="mb-4">
              {/* 关系编辑功能 */}
              <p>关系功能待实现</p>
            </div>
          </TabPane>
          
          {/* AI模型标签页 */}
          <TabPane tab="AI模型" key="llm">
            <div className="mb-4">
              <Divider orientation="left">专属AI模型配置</Divider>
              <p className="mb-4">为该角色配置独立的AI语言模型，用于生成对话和行为。</p>
              
              {isEditing ? (
                <ModelSelector 
                  value={agent.llmConfig} 
                  onChange={handleLLMConfigChange}
                />
              ) : (
                <Collapse>
                  <Panel header="查看AI模型配置" key="1">
                    <p><strong>提供商:</strong> {agent.llmConfig.provider}</p>
                    <p><strong>模型:</strong> {agent.llmConfig.model}</p>
                    <p><strong>温度:</strong> {agent.llmConfig.temperature}</p>
                    <p><strong>最大Token:</strong> {agent.llmConfig.maxTokens}</p>
                  </Panel>
                </Collapse>
              )}
            </div>
          </TabPane>
        </Tabs>
      </Card>
    </div>
  );
}
